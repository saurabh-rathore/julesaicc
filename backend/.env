PORT=3000
JWT_SECRET=yourverysecretkey # Replace with a strong, random key in production
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password # Replace with your actual DB password
DB_NAME=ai_call_center

# Asterisk Manager Interface (AMI) credentials
AMI_HOST=localhost
AMI_PORT=5038
AMI_USERNAME=admin
AMI_PASSWORD=adminsecret

# Coqui TTS URL (if self-hosted or specific endpoint)
COQUI_TTS_URL=http://localhost:5002/api/tts

# Whisper STT URL (if self-hosted or specific endpoint)
# Potentially, this could be a local command or library call, not a URL
WHISPER_MODEL=base.en # Default model

# LLM API Endpoint (Example for a local Ollama instance)
LLM_API_URL=http://localhost:11434/api/generate
LLM_MODEL_NAME=llama2 # Or your preferred model
