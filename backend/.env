# Backend Server Configuration
PORT=3000
JWT_SECRET=a_very_strong_and_long_random_secret_string_generated_for_production
JWT_EXPIRES_IN=1h

# Database Configuration
# These credentials must match the user created in the previous step.
DB_HOST=localhost
DB_USER=ai_user
DB_PASSWORD=a_very_strong_password
DB_NAME=ai_call_center

# Asterisk Manager Interface (AMI) Configuration
# These credentials must match what will be set in /etc/asterisk/manager.conf
AMI_HOST=localhost
AMI_PORT=5038
AMI_USERNAME=ami_user
AMI_PASSWORD=another_strong_password

# Asterisk Application Configuration
ASTERISK_QUEUE_CONTEXT=queues
ASTERISK_QUEUE_NAME=support-queue

# External AI Services URLs
COQUI_TTS_URL=http://localhost:5002/api/tts
LLM_API_URL=http://localhost:11434/api/generate
# RASA_API_URL=http://localhost:5005/model/parse # Uncomment if using Rasa

# AI Model and Path Configuration
WHISPER_MODEL=base.en
RECORDING_PATH=/var/lib/asterisk/sounds/en/records # A common writable path for Asterisk
TTS_AUDIO_PATH=/tmp/tts_audio

# LLM Model Configuration
LLM_MODEL_NAME=llama2
# LLM_API_KEY= # Uncomment and set if your LLM requires an API key
