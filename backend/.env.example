# Backend Server Configuration
PORT=3000

# JWT Authentication
JWT_SECRET=yourSuperSecretKeyForJWT # PLEASE CHANGE THIS IN YOUR .env FILE
JWT_EXPIRES_IN=1h

# MySQL Database Connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password # Replace with your actual DB password
DB_NAME=ai_call_center

# Asterisk Manager Interface (AMI) Credentials
AMI_HOST=localhost
AMI_PORT=5038
AMI_USERNAME=admin # Should match manager.conf
AMI_PASSWORD=adminsecret # Should match manager.conf

# Asterisk Queue Configuration (for escalations)
ASTERISK_QUEUE_CONTEXT=queues
ASTERISK_QUEUE_NAME=support-queue

# Coqui TTS Configuration
COQUI_TTS_URL=http://localhost:5002/api/tts # URL of your Coqui TTS server
TTS_AUDIO_PATH=/tmp/tts_audio # Writable path for temporary TTS audio files
TTS_WORDS_PER_MINUTE=150 # Used for estimating TTS playback duration
TTS_BUFFER_MS=500 # Additional buffer in ms to wait after estimated TTS duration

# Whisper STT Configuration
WHISPER_MODEL=base.en # Or small, medium, large, or language-specific like base.en
RECORDING_PATH=/tmp/asterisk_recordings # Writable path for Asterisk recordings for STT

# Large Language Model (LLM) Configuration
LLM_API_URL=http://localhost:11434/api/generate # Example for Ollama running Llama2
LLM_MODEL_NAME=llama2 # Or your preferred model
# LLM_API_KEY= # Optional: API Key if your LLM provider requires one

# AI Call Handler Configuration
CUSTOMER_UTTERANCE_DURATION_MS=7000 # Max time in milliseconds for AGI RECORD FILE timeout
MAX_SILENCE_SECONDS=3 # Max seconds of silence before AGI RECORD FILE stops
GREETING_MESSAGE="Hello! Thank you for calling. How can I help you today?"
ERROR_MESSAGE_TTS="I'm sorry, I encountered a technical difficulty. Please try calling back later."
DID_NOT_UNDERSTAND_MESSAGE="I'm sorry, I didn't quite catch that. Could you please say that again?"
AGI_NOTIFY_URL=http://localhost:3000/api/internal/recording-complete # URL for AGI script to notify backend
# AGI_ASTERSK_SOUNDS_PATH=/var/lib/asterisk/sounds/ # Path to standard Asterisk sounds like 'beep'
