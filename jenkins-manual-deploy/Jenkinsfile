// Jenkinsfile for deploying the AI Call Center to MANUALLY PROVISIONED infrastructure.
// This pipeline assumes that the AWS EC2 instances, RDS, S3 bucket, etc., already exist.

pipeline {
    agent any

    // Parameters to be provided by the user when running the pipeline.
    // These replace the values that would have been generated by Terraform.
    parameters {
        string(name: 'APP_SERVER_IP', defaultValue: '', description: 'The public IP address of the Application EC2 instance.')
        string(name: 'AI_SERVER_IP', defaultValue: '', description: 'The public IP address of the AI/ML EC2 instance.')
        string(name: 'S3_BUCKET_NAME', defaultValue: '', description: 'The name of the S3 bucket for the frontend assets.')
        // For a real deployment, you would also add parameters for SSH user, key file path, etc.
    }

    environment {
        // AWS credentials are still needed for deploying the frontend to S3.
        AWS_CREDENTIALS = credentials('aws-credentials')
        AWS_REGION      = 'us-east-1'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Backend CI') {
            steps {
                echo 'Building and testing the backend...'
                dir('backend') {
                    sh 'npm install'
                    sh 'npm test'
                }
            }
        }

        stage('Frontend CI') {
            steps {
                echo 'Building the frontend...'
                dir('frontend/ai-call-center-frontend') {
                    sh 'npm install'
                    sh 'npm run build -- --configuration production'
                }
            }
        }

        stage('Deploy Application') {
            // This stage requires the user to have manually provisioned the infrastructure
            // and provided the necessary details as parameters to this pipeline.
            input "Proceed with deploying to manual infrastructure?"
            parallel {
                stage('Deploy Frontend to S3') {
                    steps {
                        echo "Deploying frontend to S3 bucket: ${params.S3_BUCKET_NAME}"
                        sh "aws s3 sync frontend/ai-call-center-frontend/dist/ai-call-center-frontend/browser/ s3://${params.S3_BUCKET_NAME}/ --delete"
                    }
                }
                stage('Deploy Backend & Asterisk') {
                    steps {
                        echo "Deploying backend and Asterisk config to App Server at ${params.APP_SERVER_IP}"
                        // This is a simplified placeholder for your deployment script.
                        // In a real pipeline, you would use Ansible or a more robust scripting approach.
                        // You would need to ensure the Jenkins agent has passwordless SSH access to the server.
                        sh '''
                           echo "Simulating deployment to ${params.APP_SERVER_IP}"
                           # A real script would look something like this:
                           # ssh -o StrictHostKeyChecking=no -i ~/.ssh/your-key.pem ubuntu@${params.APP_SERVER_IP} "
                           #   set -e
                           #   echo 'Pulling latest code...'
                           #   cd /home/ubuntu/ai-call-center
                           #   git pull origin main
                           #   echo 'Installing backend dependencies...'
                           #   cd backend
                           #   npm install
                           #   echo 'Reloading backend service...'
                           #   pm2 reload all
                           #   echo 'Updating Asterisk configuration...'
                           #   sudo cp ../asterisk_config/* /etc/asterisk/
                           #   sudo asterisk -rx \'core reload\'
                           #   echo 'Deployment to app server complete.'
                           # "
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Manual infrastructure deployment pipeline finished.'
        }
    }
}
